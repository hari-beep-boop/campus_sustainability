# Server
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/campus-sustainability
JWT_SECRET=your_jwt_secret_here_at_least_32_characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Gemini AI — Add your Google Gemini API key here
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Grid emission factor (kg CO2e per kWh) - India default
GRID_EMISSION_FACTOR=0.71

# Web
VITE_API_BASE_URL=/api/v1
